import { useState, useEffect, useRef, useCallback } from 'react';
import { Link } from 'react-router-dom';
import { Menu, X, ChevronRight, ArrowRight, ChevronDown } from 'lucide-react';

interface ServiceItem {
  title: string;
  description: string;
  link: string;
  crossSell?: { text: string; link: string };
}

interface ServiceCategory {
  id: string;
  name: string;
  link?: string;
  badge?: string;
  items: ServiceItem[];
}

interface InfrastructureCategory {
  id: string;
  name: string;
  items: ServiceItem[];
}

interface AboutCategory {
  id: string;
  name: string;
  content: React.ReactNode;
}

interface SolutionItem {
  id: string;
  title: string;
  subtitle: string;
  description: string;
  combines: string[];
  link: string;
  featured?: boolean;
}

const Navigation = () => {
  const [isScrolled, setIsScrolled] = useState(false);
  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);
  const [activeMegaMenu, setActiveMegaMenu] = useState<string | null>(null);
  const [activeCategory, setActiveCategory] = useState<string>('cloud-devops');
  const [activeInfraCategory, setActiveInfraCategory] = useState<string>('hardware-support');
  const [activeAboutCategory, setActiveAboutCategory] = useState<string>('company-overview');
  const [mobileActiveTab, setMobileActiveTab] = useState<string>('solutions');
  const [mobileExpandedCategory, setMobileExpandedCategory] = useState<string | null>(null);
  const closeTimerRef = useRef<NodeJS.Timeout | null>(null);
  const megaMenuRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const handleScroll = () => setIsScrolled(window.scrollY > 50);
    window.addEventListener('scroll', handleScroll, { passive: true });
    return () => window.removeEventListener('scroll', handleScroll);
  }, []);

  useEffect(() => {
    const handleClickOutside = (event: MouseEvent) => {
      if (megaMenuRef.current && !megaMenuRef.current.contains(event.target as Node)) {
        setActiveMegaMenu(null);
      }
    };
    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  const handleMouseEnter = useCallback((menu: string) => {
    if (closeTimerRef.current) {
      clearTimeout(closeTimerRef.current);
      closeTimerRef.current = null;
    }
    if (menu === 'cloud') setActiveCategory('cloud-devops');
    if (menu === 'infrastructure') setActiveInfraCategory('hardware-support');
    if (menu === 'about') setActiveAboutCategory('company-overview');
    setActiveMegaMenu(menu);
  }, []);

  const handleMouseLeave = useCallback(() => {
    closeTimerRef.current = setTimeout(() => {
      setActiveMegaMenu(null);
    }, 150);
  }, []);

  const cloudCategories: ServiceCategory[] = [
    { id: 'cloud-devops', name: 'Cloud & DevOps', link: '/services/cloud-devops', items: [
      { title: 'Container Orchestration', description: 'Deploy 10x faster with zero downtime', link: '#services', crossSell: { text: 'See also: Managed Kubernetes', link: '#services' }},
      { title: 'Deployment Pipelines', description: 'From code commit to production in under 1 hour', link: '#services', crossSell: { text: 'Part of: Cloud Control Solution', link: '#services' }},
      { title: 'Cloud Migration', description: 'Zero-downtime migration with risk insurance', link: '#services', crossSell: { text: 'Start with: Hardware Audit', link: '#services' }},
      { title: 'Cloud Provisioning', description: 'New environments in minutes, not weeks', link: '#services' },
      { title: 'DevSecOps Integration', description: 'Security checks that don\'t slow down developers', link: '#services' },
    ]},
    { id: 'app-modernisation', name: 'Application Modernisation', link: '/services/app-modernisation', items: [
      { title: 'Legacy App Refactoring', description: 'Transform monoliths to microservices', link: '#services' },
      { title: 'API Integration', description: 'Connect legacy systems to modern cloud', link: '#services' },
      { title: 'Cloud-Native Development', description: 'Build for scale from day one', link: '#services' },
    ]},
    { id: 'mlops-ai', name: 'MLOps & AI', badge: 'POPULAR', link: '/services/mlops-ai', items: [
      { title: 'MLOps Development', description: 'From notebook to production pipeline', link: '#services', crossSell: { text: 'Bundle: AI Accelerator Solution', link: '#services' }},
      { title: 'Model Deployment & Monitoring', description: 'Detect model drift before it costs you', link: '#services' },
      { title: 'Agentic AI Development', description: 'Build autonomous AI agents for complex workflows', link: '#services' },
      { title: 'MLOps Consulting', description: 'Is your data ready for AI? Find out in 2 weeks', link: '#services' },
    ]},
    { id: 'observability', name: 'Observability', link: '/services/observability', items: [
      { title: 'Application Performance', description: 'Slow app? We find why in 5 minutes', link: '#services' },
      { title: 'Cloud Observability', description: 'Container and serverless visibility that scales', link: '#services' },
      { title: 'Data Observability', description: 'Bad data detected before it hits the dashboard', link: '#services' },
      { title: 'Pipeline Monitoring', description: 'Failed deployment? Know in seconds, not hours', link: '#services' },
    ]},
    { id: 'optimisation', name: 'Optimisation (FinOps)', link: '/services/optimisation', items: [
      { title: 'Cloud Cost Optimisation', description: 'Cut AWS/Azure bills by 40% without performance loss', link: '/services/cloud-cost-optimization', crossSell: { text: 'See: Cloud Control Solution', link: '#services' }},
      { title: 'Performance Optimisation', description: '2x faster applications, 50% less infrastructure', link: '#services' },
      { title: 'Infrastructure Right-Sizing', description: 'Pay for what you use, not what you provisioned', link: '#services' },
    ]},
  ];

  const infrastructureCategories: InfrastructureCategory[] = [
    { id: 'hardware-support', name: 'Hardware Support', items: [
      { title: 'ServerAudit™', description: 'Comprehensive server health assessments', link: '#services' },
      { title: 'Third-Party Maintenance', description: 'Save 60% vs. vendor support contracts', link: '#services', crossSell: { text: 'Next step: Cloud Migration Readiness', link: '#services' }},
      { title: 'Hardware Lifecycle Extension', description: 'Get 2-3 more years from existing equipment', link: '#services' },
      { title: 'Spare Parts Management', description: 'Critical parts on-site within 4 hours', link: '#services' },
    ]},
    { id: 'datacenter', name: 'Data Center Services', items: [
      { title: 'Hybrid Cloud Architecture', description: 'On-premise + cloud that actually works', link: '#services' },
      { title: 'Colocation Management', description: 'We manage your racks, you focus on business', link: '#services' },
      { title: 'DC Migration', description: 'Zero-downtime data center relocations', link: '#services' },
    ]},
    { id: 'sla-support', name: '24x7 SLA Support', items: [
      { title: '15-Minute Response', description: 'Emergency support when you need it most', link: '#services' },
      { title: '99.9% Uptime Guarantee', description: 'SLA-backed availability with penalties', link: '#services' },
      { title: 'Proactive Monitoring', description: 'Fix issues before they impact users', link: '#services' },
    ]},
    { id: 'continuity', name: 'Business Continuity', items: [
      { title: 'Disaster Recovery', description: 'RTO under 1 hour, tested quarterly', link: '#services' },
      { title: 'Backup Solutions', description: 'Immutable backups, air-gapped storage', link: '#services' },
      { title: 'High Availability Design', description: 'Zero single points of failure', link: '#services' },
    ]},
  ];

  const platforms: ServiceItem[] = [
    { title: 'ServiceNow', description: 'Go live in 8 weeks, not 8 months', link: '#services', crossSell: { text: 'See also: Managed ServiceNow', link: '#services' }},
    { title: 'IBM Maximo', description: 'From reactive maintenance to predictive', link: '#services' },
    { title: 'Jira Service Management', description: 'Developer-friendly ITSM that actually gets used', link: '#services' },
    { title: 'Custom Integrations', description: 'Connect your existing tools to work as one', link: '#services' },
  ];

  const solutions: SolutionItem[] = [
    { id: 'ai-accelerator', title: 'AI Accelerator', subtitle: 'From Data to Production AI', description: 'From data to deployed AI in 90 days', combines: ['MLOps', 'Cloud Infrastructure', 'Data Observability', 'Consulting'], link: '#services', featured: true },
    { id: 'cloud-control', title: 'Cloud Control', subtitle: 'Cost & Performance Management', description: 'Cut cloud costs 40% and never worry about uptime', combines: ['FinOps', 'Cloud Optimisation', 'Observability', 'Managed Cloud'], link: '#services' },
    { id: 'service-excellence', title: 'Service Excellence', subtitle: 'ITSM & Support Operations', description: '95% user satisfaction, 60% cost reduction', combines: ['ServiceNow', 'Service Desk', 'ITSM Processes', 'Automation'], link: '#services' },
    { id: 'total-transformation', title: 'Total Transformation', subtitle: 'Hardware to Cloud Journey', description: 'End-to-end: Hardware audit → Cloud migration → Managed operations', combines: ['ServerAudit™', 'Cloud Migration', 'Managed Services', 'Optimisation'], link: '#services' },
  ];

  const aboutCategories: AboutCategory[] = [
    { id: 'company-overview', name: 'Company Overview', content: (
      <div className="space-y-8">
        <div className="grid grid-cols-2 gap-6">
          <div className="p-5 bg-gray-50 rounded-lg">
            <h4 className="font-semibold text-[#161616] mb-2 text-sm">Our Story</h4>
            <p className="text-sm text-[#525252] leading-relaxed">Founded by British-certified technologists, delivering enterprise IT solutions across Pakistan and the UK since 2010.</p>
          </div>
          <div className="p-5 bg-gray-50 rounded-lg">
            <h4 className="font-semibold text-[#161616] mb-2 text-sm">Our Mission</h4>
            <p className="text-sm text-[#525252] leading-relaxed">Make enterprise-grade IT accessible to ambitious organizations in emerging markets.</p>
          </div>
        </div>
        <div className="flex gap-10 pt-4">
          <div className="text-center">
            <div className="text-3xl font-bold text-pi-blue">14+</div>
            <div className="text-sm text-[#525252] mt-1">Years Experience</div>
          </div>
          <div className="text-center">
            <div className="text-3xl font-bold text-pi-blue">50+</div>
            <div className="text-sm text-[#525252] mt-1">Platforms Deployed</div>
          </div>
          <div className="text-center">
            <div className="text-3xl font-bold text-pi-blue">24/7</div>
            <div className="text-sm text-[#525252] mt-1">Support Coverage</div>
          </div>
        </div>
      </div>
