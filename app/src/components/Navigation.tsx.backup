    { id: 'careers', name: 'Careers', content: (
      <div className="space-y-6">
        <p className="text-sm text-[#525252] leading-relaxed">Join a team where enterprise standards meet innovation.</p>
        <div className="space-y-3">
          <div className="p-4 bg-gray-50 rounded-lg flex justify-between items-center group hover:bg-gray-100 transition-colors cursor-pointer">
            <div>
              <h4 className="font-medium text-[#161616] text-sm">Senior DevOps Engineer</h4>
              <p className="text-xs text-[#525252] mt-0.5">Lahore • Full-time</p>
            </div>
            <ChevronRight className="w-4 h-4 text-pi-blue" />
          </div>
          <div className="p-4 bg-gray-50 rounded-lg flex justify-between items-center group hover:bg-gray-100 transition-colors cursor-pointer">
            <div>
              <h4 className="font-medium text-[#161616] text-sm">ServiceNow Consultant</h4>
              <p className="text-xs text-[#525252] mt-0.5">Lahore • Full-time</p>
            </div>
            <ChevronRight className="w-4 h-4 text-pi-blue" />
          </div>
        </div>
      </div>
    )},
    { id: 'partners', name: 'Partners', content: (
      <div className="space-y-6">
        <div className="grid grid-cols-3 gap-4">
          <div className="p-5 bg-gray-50 rounded-lg text-center">
            <div className="text-lg font-bold text-pi-blue mb-1">Huawei</div>
            <p className="text-xs text-[#525252]">Enterprise Partner</p>
          </div>
          <div className="p-5 bg-gray-50 rounded-lg text-center">
            <div className="text-lg font-bold text-pi-blue mb-1">ServiceNow</div>
            <p className="text-xs text-[#525252]">Implementation Partner</p>
          </div>
          <div className="p-5 bg-gray-50 rounded-lg text-center">
            <div className="text-lg font-bold text-pi-blue mb-1">EZY</div>
            <p className="text-xs text-[#525252]">Distribution Alliance</p>
          </div>
        </div>
        <p className="text-sm text-[#525252] leading-relaxed">Strategic partnerships that extend our capabilities and reach.</p>
      </div>
    )},
    { id: 'contact-info', name: 'Contact', content: (
      <div className="grid grid-cols-2 gap-8">
        <div>
          <h4 className="font-semibold text-[#161616] mb-3 text-sm uppercase tracking-wide">Pakistan</h4>
          <p className="text-sm text-[#525252] leading-relaxed">Office #01, 1st Floor, Liberty Gate Plaza</p>
          <p className="text-sm text-[#525252] leading-relaxed">Tariq Road, Gulberg III, Lahore</p>
          <p className="text-sm text-pi-blue mt-3 font-medium">+92 301 8436565</p>
        </div>
        <div>
          <h4 className="font-semibold text-[#161616] mb-3 text-sm uppercase tracking-wide">United Kingdom</h4>
          <p className="text-sm text-[#525252] leading-relaxed">12a Fleet Business Park, Sandy Lane</p>
          <p className="text-sm text-[#525252] leading-relaxed">Fleet, Hampshire, GU52 8BF</p>
          <p className="text-sm text-pi-blue mt-3 font-medium">+44 7456 457005</p>
        </div>
      </div>
