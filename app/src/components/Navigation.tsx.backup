                              <p className="text-xs text-blue-600 mb-2 font-semibold uppercase tracking-wide">{solution.subtitle}</p>
                              <p className="text-sm text-[#525252] mb-4 leading-relaxed">{solution.description}</p>
                              <div className="flex flex-wrap gap-1.5">
                                {solution.combines.map((item, i) => <span key={i} className="px-2 py-1 bg-white border border-blue-200 text-[11px] text-[#525252] rounded font-medium">{item}</span>)}
                              </div>
                            </a>
                          ))}
                        </div>
                      </div>
                      {/* Footer CTA */}
                      <div className="border-t border-gray-200 bg-gray-50/50">
