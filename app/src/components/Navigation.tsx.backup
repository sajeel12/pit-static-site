                      </div>
                      {/* Content - Left Rail with Blue Color Accents */}
                      <div className="max-w-[1400px] mx-auto flex">
                        <div className="w-[280px] bg-gradient-to-b from-blue-50/30 to-transparent p-6 flex-shrink-0 border-r border-gray-200">
                          <div className="space-y-1">
                            {infrastructureCategories.map((category) => (
                              <button 
                                key={category.id} 
                                onMouseEnter={() => setActiveInfraCategory(category.id)} 
                                className={`w-full text-left px-4 py-3 text-sm rounded-lg transition-all ${activeInfraCategory === category.id ? 'bg-white shadow-md border-l-[4px] border-blue-500 text-[#161616] font-bold' : 'text-[#525252] hover:bg-blue-100/50'}`}
                              >
                                {category.name}
                              </button>
                            ))}
                            <div className="border-t border-blue-200 my-3" />
                            <a href="#services" className="flex items-center gap-2 px-4 py-3 text-sm font-bold text-blue-600 hover:text-blue-700">
                              View All Infrastructure<ArrowRight className="w-4 h-4" />
                            </a>
                          </div>
                        </div>
                        <div className="flex-1 p-8 bg-white">
                          {/* Huawei Banner with Blue Accent */}
                          <div className="bg-gradient-to-r from-blue-100 to-blue-50 border border-blue-200 rounded-lg p-5 mb-6">
                            <div className="flex items-center gap-4">
                              <div className="w-12 h-12 bg-white rounded-lg flex items-center justify-center flex-shrink-0 shadow-sm border border-blue-200">
                                <svg width="32" height="32" viewBox="0 0 100 100" fill="none"><path d="M50 10C45 25 35 35 20 40C35 45 45 55 50 70C55 55 65 45 80 40C65 35 55 25 50 10Z" fill="#FF0000"/><path d="M50 75C47.5 82.5 42.5 87.5 35 90C42.5 87.5 47.5 82.5 50 75Z" fill="#FF0000"/></svg>
                              </div>
                              <div>
                                <h4 className="font-bold text-[#161616] text-sm">Huawei Enterprise Partner</h4>
                                <p className="text-xs text-[#525252] mt-0.5">Authorized support for servers, storage & networking</p>
                              </div>
                            </div>
                          </div>
                          <a href="#services" className="inline-flex items-center gap-2 text-base font-bold text-blue-600 hover:text-blue-700 mb-6 group">
                            {getActiveInfraCategory().name}<ArrowRight className="w-5 h-5 group-hover:translate-x-1 transition-transform" />
                          </a>
                          <div className="grid grid-cols-2 gap-x-8 gap-y-5">
                            {getActiveInfraCategory().items.map((item, idx) => (
                              <div key={idx} className="group p-3 rounded-lg hover:bg-blue-50/30 transition-colors">
                                <a href={item.link} className="block">
                                  <h4 className="text-[13px] font-bold text-[#161616] group-hover:text-blue-600 mb-1.5">{item.title}</h4>
                                  <p className="text-xs text-[#525252] leading-relaxed">{item.description}</p>
                                </a>
                                {item.crossSell && <a href={item.crossSell.link} className="text-xs text-blue-600 hover:underline inline-flex items-center gap-1 mt-2 font-semibold">{item.crossSell.text}<ArrowRight className="w-3 h-3" /></a>}
                              </div>
                            ))}
                          </div>
                          <div className="mt-8 pt-5 border-t border-blue-100 bg-blue-50/20 -mx-8 px-8 py-4">
                            <a href="#services" className="inline-flex items-center gap-2 text-sm font-bold text-blue-600 hover:text-blue-700">
                              <span>Ready for cloud?</span><span>Explore Cloud Migration Readiness →</span>
                            </a>
                          </div>
                        </div>
                      </div>
                      {/* Footer CTA */}
                      <div className="border-t border-gray-200 bg-gray-50/50">
                        <div className="max-w-[1400px] mx-auto px-8 py-5">
                          <a href="#services" className="flex items-center justify-center gap-2 text-sm font-bold text-blue-600 hover:text-blue-700 transition-colors uppercase tracking-wider">
                            Explore all infrastructure services <ArrowRight className="w-4 h-4" />
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                )}
              </div>

              {/* PLATFORMS */}
              <div 
                className="relative" 
                onMouseEnter={() => handleMouseEnter('platforms')}
                onMouseLeave={handleMouseLeave}
              >
                <button className={`flex items-center gap-1 px-4 py-2 text-sm font-medium transition-colors ${activeMegaMenu === 'platforms' ? 'text-pi-blue' : 'text-[#161616] hover:text-pi-blue'}`}>
                  Platforms<ChevronRight className={`w-4 h-4 transition-transform ${activeMegaMenu === 'platforms' ? 'rotate-90' : ''}`} />
                </button>
                {activeMegaMenu === 'platforms' && (
                  <div className="fixed left-0 right-0 top-20 z-50">
                    {/* Invisible bridge */}
                    <div className="absolute -top-4 left-0 right-0 h-4" />
                    <div className="bg-white border-b border-gray-200 shadow-2xl overflow-hidden w-full">
                      {/* Header - Blue Theme */}
                      <div className="bg-gradient-to-r from-blue-500/10 to-blue-400/5 border-b border-blue-200">
                        <div className="max-w-[1400px] mx-auto px-8 py-6">
                          <h3 className="text-base font-bold text-[#161616]">Platform Services</h3>
                          <p className="text-sm text-[#525252] mt-1">Enterprise platforms implemented and managed</p>
                        </div>
                      </div>
                      {/* Content - Left Rail with Blue Color Accents */}
                      <div className="max-w-[1400px] mx-auto flex">
                        <div className="w-[260px] bg-gradient-to-b from-blue-50/30 to-transparent p-6 flex-shrink-0 border-r border-gray-200">
                          <div className="space-y-1">
                            {platforms.map((platform, idx) => (
                              <a key={idx} href={platform.link} className="block px-4 py-3 text-sm rounded-lg text-[#525252] hover:bg-blue-100/50 transition-all font-semibold">{platform.title}</a>
                            ))}
                            <div className="border-t border-blue-200 my-3" />
                            <a href="#services" className="flex items-center gap-2 px-4 py-3 text-sm font-bold text-blue-600 hover:text-blue-700">
                              View All Platforms<ArrowRight className="w-4 h-4" />
                            </a>
                          </div>
                        </div>
                        <div className="flex-1 p-8 bg-white">
                          <h3 className="text-base font-bold text-blue-700 mb-2">Platform Services</h3>
                          <p className="text-sm text-[#525252] mb-6 leading-relaxed">ServiceNow, Maximo & Custom Implementations. We don't just install — we configure, integrate, and manage.</p>
                          <div className="space-y-5">
                            {platforms.slice(0, 2).map((platform, idx) => (
                              <div key={idx} className="group p-3 rounded-lg hover:bg-blue-50/30 transition-colors">
                                <a href={platform.link} className="block">
                                  <h4 className="text-[13px] font-bold text-[#161616] group-hover:text-blue-600 mb-1.5">{platform.title}</h4>
                                  <p className="text-xs text-[#525252] leading-relaxed">{platform.description}</p>
                                </a>
                                {platform.crossSell && <a href={platform.crossSell.link} className="text-xs text-blue-600 hover:underline inline-flex items-center gap-1 mt-2 font-semibold">{platform.crossSell.text}<ArrowRight className="w-3 h-3" /></a>}
                              </div>
                            ))}
                          </div>
                          <div className="mt-6 p-4 bg-blue-50 rounded-lg border border-blue-200">
                            <p className="text-xs text-[#525252] leading-relaxed">Need ongoing platform management? See our <a href="#services" className="text-blue-600 font-bold hover:underline">Managed Platform Services</a></p>
                          </div>
                        </div>
                      </div>
                      {/* Footer CTA */}
                      <div className="border-t border-gray-200 bg-gray-50/50">
                        <div className="max-w-[1400px] mx-auto px-8 py-5">
                          <a href="#services" className="flex items-center justify-center gap-2 text-sm font-bold text-blue-600 hover:text-blue-700 transition-colors uppercase tracking-wider">
                            Explore all platform services <ArrowRight className="w-4 h-4" />
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                )}
              </div>

              {/* ABOUT */}
              <div 
                className="relative" 
                onMouseEnter={() => handleMouseEnter('about')}
                onMouseLeave={handleMouseLeave}
              >
                <button className={`flex items-center gap-1 px-4 py-2 text-sm font-medium transition-colors ${activeMegaMenu === 'about' ? 'text-pi-blue' : 'text-[#161616] hover:text-pi-blue'}`}>
                  About<ChevronRight className={`w-4 h-4 transition-transform ${activeMegaMenu === 'about' ? 'rotate-90' : ''}`} />
                </button>
                {activeMegaMenu === 'about' && (
                  <div className="fixed left-0 right-0 top-20 z-50">
                    {/* Invisible bridge */}
                    <div className="absolute -top-4 left-0 right-0 h-4" />
                    <div className="bg-white border-b border-gray-200 shadow-2xl overflow-hidden w-full">
                      {/* Header - Blue Theme */}
                      <div className="bg-gradient-to-r from-blue-500/10 to-blue-400/5 border-b border-blue-200">
                        <div className="max-w-[1400px] mx-auto px-8 py-6">
                          <h3 className="text-base font-bold text-[#161616]">About Perception IT</h3>
                          <p className="text-sm text-[#525252] mt-1">Your partner from hardware to cloud</p>
                        </div>
                      </div>
                      {/* Content - Left Rail with Blue Color Accents */}
                      <div className="max-w-[1400px] mx-auto flex">
                        <div className="w-[240px] bg-gradient-to-b from-blue-50/30 to-transparent p-6 flex-shrink-0 border-r border-gray-200">
                          <div className="space-y-1">
                            {aboutCategories.map((category) => (
                              <button 
                                key={category.id} 
                                onMouseEnter={() => setActiveAboutCategory(category.id)} 
                                className={`w-full text-left px-4 py-3 text-sm rounded-lg transition-all ${activeAboutCategory === category.id ? 'bg-white shadow-md border-l-[4px] border-blue-500 text-[#161616] font-bold' : 'text-[#525252] hover:bg-blue-100/50'}`}
                              >
                                {category.name}
                              </button>
                            ))}
                            <div className="border-t border-blue-200 my-3" />
                            <Link to="/projects" className="block px-4 py-3 text-sm rounded-lg text-[#525252] hover:bg-blue-100/50 transition-all font-semibold" onClick={() => setActiveMegaMenu(null)}>Projects</Link>
                          </div>
                        </div>
                        <div className="flex-1 p-8 bg-white">
                          <a href="#about" className="inline-flex items-center gap-2 text-base font-bold text-blue-700 hover:text-blue-800 mb-5 group">
                            {getActiveAboutCategory().name}<ArrowRight className="w-5 h-5 text-blue-500 group-hover:translate-x-1 transition-transform" />
                          </a>
                          <div className="text-sm text-[#525252]">{getActiveAboutCategory().content}</div>
                        </div>
                      </div>
                      {/* Footer CTA */}
                      <div className="border-t border-gray-200 bg-gray-50/50">
                        <div className="max-w-[1400px] mx-auto px-8 py-5">
                          <a href="#contact" className="flex items-center justify-center gap-2 text-sm font-bold text-blue-700 hover:text-blue-800 transition-colors uppercase tracking-wider">
                            Get in touch <ArrowRight className="w-4 h-4" />
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </div>

            <div className="hidden lg:block">
              <a href="#contact" className="inline-flex items-center px-5 py-2.5 bg-pi-blue text-white text-sm font-medium rounded-lg hover:bg-pi-blue-dark transition-colors">Contact</a>
            </div>

            <button onClick={() => setIsMobileMenuOpen(!isMobileMenuOpen)} className="lg:hidden p-2 text-[#161616]">
              {isMobileMenuOpen ? <X className="w-6 h-6" /> : <Menu className="w-6 h-6" />}
            </button>
          </div>
        </div>
      </nav>

      {/* Mobile Menu */}
      {isMobileMenuOpen && (
        <div className="fixed inset-0 z-40 lg:hidden bg-white">
          <div className="flex items-center justify-between px-4 h-16 border-b border-gray-100">
            <Link to="/" className="flex items-center" onClick={() => setIsMobileMenuOpen(false)}>
              <img src="/logo_icon.png" alt="Perception IT" className="h-8 w-auto" />
            </Link>
            <button onClick={() => setIsMobileMenuOpen(false)} className="p-2 text-[#161616]"><X className="w-6 h-6" /></button>
          </div>
          <div className="border-b border-gray-100 overflow-x-auto scrollbar-hide">
            <div className="flex px-2 py-3 gap-1 min-w-max">
              {mobileTabs.map((tab) => (
                <button key={tab.id} onClick={() => { setMobileActiveTab(tab.id); setMobileExpandedCategory(null); }} className={`px-4 py-2 text-sm font-medium rounded-full whitespace-nowrap transition-colors ${mobileActiveTab === tab.id ? 'bg-pi-blue text-white' : 'bg-gray-100 text-[#525252] hover:bg-gray-200'}`}>
                  {tab.label}
                </button>
              ))}
            </div>
          </div>
          <div className="px-4 py-4 h-[calc(100vh-140px)] overflow-y-auto">
            {mobileActiveTab === 'solutions' && (
              <div className="space-y-4">
                <p className="text-sm text-[#525252] mb-4">Integrated services from hardware to cloud</p>
                {solutions.map((solution) => (
                  <div key={solution.id} className={`p-4 rounded-lg border ${solution.featured ? 'border-pi-blue bg-pi-blue/5' : 'border-gray-200'}`}>
                    <div className="flex items-center justify-between mb-1">
                      <h3 className="font-semibold text-[#161616]">{solution.title}</h3>
                      {solution.featured && <span className="text-[10px] px-2 py-0.5 bg-pi-blue text-white rounded font-medium">POPULAR</span>}
                    </div>
                    <p className="text-xs text-[#525252] mb-2">{solution.subtitle}</p>
                    <p className="text-sm text-[#525252] mb-3">{solution.description}</p>
                    <div className="flex flex-wrap gap-1 mb-3">
                      {solution.combines.map((item, idx) => <span key={idx} className="px-2 py-0.5 bg-gray-100 text-[10px] text-[#525252] rounded">{item}</span>)}
                    </div>
                    <a href={solution.link} className="text-sm text-pi-blue font-medium inline-flex items-center gap-1">Learn more <ArrowRight className="w-4 h-4" /></a>
                  </div>
                ))}
                <a href="#services" className="block w-full text-center py-3 bg-pi-blue text-white rounded-lg font-medium">Talk to an architect</a>
              </div>
            )}
            {mobileActiveTab === 'cloud' && (
              <div className="space-y-2">
                {cloudCategories.map((category) => (
                  <div key={category.id} className="border border-gray-200 rounded-lg overflow-hidden">
                    <button onClick={() => setMobileExpandedCategory(mobileExpandedCategory === category.id ? null : category.id)} className="w-full flex items-center justify-between px-4 py-3 text-left">
                      <span className="font-medium text-[#161616]">{category.name}</span>
                      <ChevronDown className={`w-5 h-5 text-[#525252] transition-transform ${mobileExpandedCategory === category.id ? 'rotate-180' : ''}`} />
                    </button>
                    {mobileExpandedCategory === category.id && (
                      <div className="px-4 pb-4 space-y-3">
                        {category.items.map((item, idx) => (
                          <div key={idx}>
                            <a href={item.link} className="block">
                              <h4 className="text-sm font-medium text-[#161616]">{item.title}</h4>
                              <p className="text-xs text-[#525252]">{item.description}</p>
                            </a>
                            {item.crossSell && <a href={item.crossSell.link} className="text-xs text-pi-blue mt-1 inline-block">{item.crossSell.text} →</a>}
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
                <div className="pt-4 border-t border-gray-200">
                  <p className="text-xs text-[#525252] mb-2">How we deliver:</p>
                  <div className="flex flex-wrap gap-2">
                    {deliveryModels.map((model, idx) => <a key={idx} href={model.link} className="px-3 py-1.5 bg-gray-100 text-xs text-[#525252] rounded-full">{model.title}</a>)}
                  </div>
                </div>
              </div>
            )}
            {mobileActiveTab === 'infrastructure' && (
              <div className="space-y-2">
                <div className="p-4 bg-pi-blue/5 border border-pi-blue/20 rounded-lg mb-4">
                  <div className="flex items-center gap-3">
                    <div className="w-10 h-10 bg-white rounded-lg flex items-center justify-center">
                      <svg width="24" height="24" viewBox="0 0 100 100" fill="none"><path d="M50 10C45 25 35 35 20 40C35 45 45 55 50 70C55 55 65 45 80 40C65 35 55 25 50 10Z" fill="#FF0000"/></svg>
                    </div>
                    <div><h4 className="font-semibold text-[#161616]">Huawei Partner</h4><p className="text-xs text-[#525252]">Authorized enterprise support</p></div>
                  </div>
                </div>
                {infrastructureCategories.map((category) => (
                  <div key={category.id} className="border border-gray-200 rounded-lg overflow-hidden">
                    <button onClick={() => setMobileExpandedCategory(mobileExpandedCategory === category.id ? null : category.id)} className="w-full flex items-center justify-between px-4 py-3 text-left">
                      <span className="font-medium text-[#161616]">{category.name}</span>
                      <ChevronDown className={`w-5 h-5 text-[#525252] transition-transform ${mobileExpandedCategory === category.id ? 'rotate-180' : ''}`} />
                    </button>
                    {mobileExpandedCategory === category.id && (
                      <div className="px-4 pb-4 space-y-3">
                        {category.items.map((item, idx) => (
                          <div key={idx}>
                            <a href={item.link} className="block">
                              <h4 className="text-sm font-medium text-[#161616]">{item.title}</h4>
                              <p className="text-xs text-[#525252]">{item.description}</p>
                            </a>
                            {item.crossSell && <a href={item.crossSell.link} className="text-xs text-pi-blue mt-1 inline-block">{item.crossSell.text} →</a>}
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
                <a href="#services" className="block p-3 bg-pi-blue/5 rounded-lg text-pi-blue text-sm">Ready for cloud? Explore Cloud Migration →</a>
              </div>
            )}
            {mobileActiveTab === 'platforms' && (
              <div className="space-y-4">
                <p className="text-sm text-[#525252]">ServiceNow, Maximo & Custom Implementations</p>
                {platforms.map((platform, idx) => (
                  <div key={idx} className="p-4 border border-gray-200 rounded-lg">
                    <a href={platform.link} className="block mb-1">
                      <h3 className="font-semibold text-[#161616]">{platform.title}</h3>
                      <p className="text-sm text-[#525252]">{platform.description}</p>
                    </a>
                    {platform.crossSell && <a href={platform.crossSell.link} className="text-xs text-pi-blue">{platform.crossSell.text} →</a>}
                  </div>
                ))}
                <div className="p-3 bg-pi-blue/5 rounded-lg border border-pi-blue/20">
                  <p className="text-sm text-[#525252]">Need ongoing management? <a href="#services" className="text-pi-blue font-medium">Managed Platform Services</a></p>
                </div>
              </div>
            )}
            {mobileActiveTab === 'about' && (
              <div className="space-y-2">
                {aboutCategories.map((category) => <a key={category.id} href="#about" className="block px-4 py-3 border border-gray-200 rounded-lg text-[#161616] font-medium">{category.name}</a>)}
                <Link to="/projects" className="block px-4 py-3 border border-gray-200 rounded-lg text-[#161616] font-medium" onClick={() => setIsMobileMenuOpen(false)}>Projects</Link>
              </div>
            )}
            <div className="mt-6 pt-6 border-t border-gray-200">
              <a href="#contact" className="block w-full text-center py-4 bg-pi-blue text-white font-medium rounded-lg" onClick={() => setIsMobileMenuOpen(false)}>Contact Us</a>
            </div>
          </div>
        </div>
      )}
    </>
  );
};

export default Navigation;
